  "chapters": [
    {
      "id": "c_001",
      "novel_id": "n_001",
      "title": "الفصل الأول: البداية في أطلال الرماد",
      "content": "كانت الرياح تعصف بشدة فوق أسوار قلعة الضباب العتيقة. جلس أدهم فوق الصخرة العالية يرقب أفق المدينة الممتد تحت ضوء القمر الفضي. لم يكن القتال مجرد خيار بالنسبة له، بل كان واجباً محتوماً لقومه الذين انتظروا العودة لسنوات طويلة. وقف وبيده سيفه المحفور عليه الرموز القديمة، جاهزاً لمواجهة أخطار الغد.",
      "description": "بداية رحلة أدهم وحكايته في القلعة العتيقة.",
      "order": 1,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_002",
      "novel_id": "n_001",
      "title": "الفصل الثاني: همس الرياح الساطعة",
      "content": "دخل أدهم إلى الممر المظلم أسفل القلعة، حيث تفوح رائحة القدم والأسرار. سرعان ما سمع صوتاً خافتاً يناديه باسمه القديم. التفت يميناً فرأى نقشاً مضيئاً على الجدار يرمز للعرش المفقود...",
      "description": "استكشاف السراديب واكتشاف الخريطة المخفية.",
      "order": 2,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_003",
      "novel_id": "n_001",
      "title": "الفصل الثالث: الفارس والأحجار السبعة",
      "content": "بدأت الرحلة الحقيقية نحو وادي الأسرار. جمع أدهم رفاقه السبعة في الفجر للبدء في البحث عن الأحجار السحرية.",
      "description": "تجميع الرفاق وتحديد الخطة الأولى.",
      "order": 3,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_004",
      "novel_id": "n_002",
      "title": "الفصل الأول: جريمة في القصر الأثري",
      "content": "في ليلة ممطرة، تسلل المفتش فريد إلى مكتبة القصر الأندلسي بعد تلقيه بلاغاً غامضاً عن اختفاء المخطوطة النادرة. وجد الباب مفتوحاً والأوراق مبعثرة على الأرض بشكل يثير الريبة.",
      "description": "بداية التحقيق الغامض واكتشاف المخطوطة المفقودة.",
      "order": 1,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_005",
      "novel_id": "n_002",
      "title": "الفصل الثاني: الرسالة المجهولة",
      "content": "عثر فريد بين طيات الكتب على مغلف أسود مغلق بالشمع الأحمر، مكتوب عليه عبارة واحدة باللغة القديمة.",
      "description": "تحليل الرسالة وتتبع الخيوط الأولى.",
      "order": 2,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_006",
      "novel_id": "n_003",
      "title": "الفصل الأول: رحيل ناعم",
      "content": "في زاوية ذلك المقهى الهادئ، جلست مريم تسجل خاطراتها في مفكرتها الصغيرة. لم تكن تعلم أن هذا اليوم سيغير مجرى حياتها بالكامل.",
      "description": "لقاء مريم الأول وبداية التغير الكبير.",
      "order": 1,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    },
    {
      "id": "c_007",
      "novel_id": "n_004",
      "title": "الفصل الأول: الإشارة الأولى من المجرة",
      "content": "تلقت المحطة الفضائية الرئيسية إشارة تردد غريبة قادمة من النظام الشمسي المجاور. قرر القائد طارق تجهيز المركبة للرحلة الاستكشافية.",
      "description": "انطلاق المركبة الفضائية الاستكشافية.",
      "order": 1,
      "created_at": "2026-08-08T15:28:11.322Z",
      "updated_at": "2026-08-08T15:28:11.322Z"
    }
  ],
