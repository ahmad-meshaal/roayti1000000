  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --alias:@workspace/db=./lib/lib/db/src/index.ts --alias:@workspace/db/schema=./lib/lib/db/src/schema/index.ts --packages=external --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); if(fs.existsSync('roayti-FULL-DATABASE.sql')) { fs.copyFileSync('roayti-FULL-DATABASE.sql', 'dist/roayti-FULL-DATABASE.sql'); } if(fs.existsSync('clean_inserts_perfect.sql')) { fs.copyFileSync('clean_inserts_perfect.sql', 'dist/clean_inserts_perfect.sql'); }\"",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
